# LLM provider: anthropic | openai | ollama | offline (default: auto-detect from keys, else offline)
LLM_PROVIDER=offline
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# GitContext settings
GITCONTEXT_INDEX_DIR=.gitcontext-index
# GITCONTEXT_REPO_URL=https://github.com/your-org/your-repo
GITCONTEXT_MODE=hybrid_rerank
GITCONTEXT_TOP_K=6
GITCONTEXT_MIN_EVIDENCE=0.35

# Optional connectors / adapters
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
